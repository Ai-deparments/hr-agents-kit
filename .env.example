# Copy to .env — never commit .env
DEBUG=0
JWT_SECRET=                      # random, >= 32 chars:  python -c "import secrets;print(secrets.token_urlsafe(48))"
ADMIN_PASSWORD=                  # first admin login (username: admin)
DATABASE_URL=sqlite:////data/hr.db   # or postgresql+psycopg://user:pass@db/hr
COMPANY_FILE=/app/config/company.yaml
WEBAPP_URL=https://hr.example.com    # public HTTPS URL (Mini App requires HTTPS)

# Claude (official Anthropic API). Without a key the agents run in offline/command mode.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
CLAUDE_FALLBACKS=1
LLM_MODE=auto                    # auto | claude | offline

# Telegram: either one hub bot that routes to all agents ...
BOT_TOKEN_HUB=
# ... and/or one bot per agent
BOT_TOKEN_HAMZA=
BOT_TOKEN_OZODA=
BOT_TOKEN_BEXRUZ=
BOT_TOKEN_HUSAYN=
BOT_TOKEN_SUHAYL=
BOT_TOKEN_RAUF=
BOT_TOKEN_REKLAMA=

OWNER_IDS=                       # comma-separated Telegram IDs
HR_HEAD_IDS=                     # HR heads + payroll accountant
PAYROLL_RESTRICTED_IDS=          # can talk to bots but never see salaries
REPORT_CHAT_ID=                  # group for 09:00 / 18:30 reports (use /guruh in the group)

AGENT_API_KEY=                   # for POST /api/agents/{name}/ask from other systems
DEV_TELEGRAM_ID=                 # DEBUG only: open the Mini App in a normal browser as this user
